#!/usr/bin/env python3
"""Run each eval case twice, once with its skills loaded and once without."""

import json, subprocess, sys, tempfile
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CASES = ROOT / "eval" / "cases"
RESULTS = ROOT / "eval" / "results"

# --restricted drops Bash and ignores user, project and local settings, so the
# only skills in play are the ones this run passes with --plugin-dir.
BASE = ["claude", "-p", "--restricted", "--strict-mcp-config", "--no-session-persistence"]


def run(case, skills):
    plugins = [arg for name in skills for arg in ("--plugin-dir", str(ROOT / "plugins" / name))]
    preamble = f"Use the {', '.join(skills)} skill{'s' if len(skills) > 1 else ''} for this task.\n\n" if skills else ""
    cmd = BASE + ["--model", case["model"]] + (plugins or ["--disable-slash-commands"])
    with tempfile.TemporaryDirectory() as cwd:
        return subprocess.run(cmd + [preamble + case["prompt"]], cwd=cwd, capture_output=True, text=True, check=True).stdout


def evaluate(path):
    case = {"model": "opus", **json.loads(path.read_text())}
    out = RESULTS / path.stem / datetime.now().strftime("%Y-%m-%d-%H%M%S")
    out.mkdir(parents=True)
    with ThreadPoolExecutor() as pool:
        without, with_ = pool.map(lambda skills: run(case, skills), [[], case["skills"]])
    (out / "prompt.md").write_text(case["prompt"])
    (out / "without.md").write_text(without)
    (out / "with.md").write_text(with_)
    print(f"{path.stem}: {out}")


paths = [Path(a) for a in sys.argv[1:]] or sorted(CASES.glob("*.json"))
for path in paths:
    evaluate(path)
